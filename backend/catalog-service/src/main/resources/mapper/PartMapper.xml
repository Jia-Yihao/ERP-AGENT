<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.erp.catalog.mapper.PartMapper">

    <resultMap id="partBriefMap" type="com.example.erp.common.core.Dtos$PartBrief">
        <id property="id" column="id"/>
        <result property="partCode" column="part_code"/>
        <result property="name" column="name"/>
        <result property="model" column="model"/>
        <result property="specification" column="specification"/>
        <result property="unit" column="unit"/>
        <result property="purchasePrice" column="purchase_price"/>
        <result property="suggestedRetailPrice" column="suggested_retail_price"/>
        <result property="stockWarningValue" column="stock_warning_value"/>
        <result property="supplierId" column="supplier_id"/>
        <result property="category" column="category"/>
        <result property="description" column="description"/>
        <result property="supplierName" column="supplier_name"/>
    </resultMap>

    <select id="selectBriefs" resultMap="partBriefMap">
        SELECT p.id, p.part_code, p.name, p.model, p.specification, p.unit,
               p.purchase_price, p.suggested_retail_price, p.stock_warning_value,
               p.supplier_id, p.category, p.description, s.name AS supplier_name
        FROM part p
        LEFT JOIN supplier s ON s.id = p.supplier_id AND s.deleted = 0
        WHERE p.deleted = 0
        <if test="ids != null and ids.size() > 0">
            AND p.id IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        </if>
        ORDER BY p.id
    </select>

    <select id="selectPageWithSupplier" resultType="com.example.erp.catalog.entity.Part">
        SELECT p.*
        FROM part p
        LEFT JOIN supplier s ON s.id = p.supplier_id AND s.deleted = 0
        WHERE p.deleted = 0
        <if test="name != null and name != ''">
            AND p.name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="category != null and category != ''">
            AND p.category = #{category}
        </if>
        <if test="supplierId != null">
            AND p.supplier_id = #{supplierId}
        </if>
        ORDER BY p.id
    </select>
</mapper>
